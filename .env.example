# Copier ce fichier en .env et adapter les valeurs.
# Sur AlwaysData : hôte = postgresql-<compte>.alwaysdata.net, base et utilisateur créés depuis l'admin AlwaysData.

APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
# Sous-répertoire de publication, uniquement si l'app n'est pas servie à la racine du domaine
# (laisser vide dans le cas standard où le document root du site pointe sur /public).
APP_BASE_PATH=
# Nom de l'organisme affiché dans l'interface (optionnel)
APP_ORGANISATION=

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=rgesn
DB_USER=rgesn
DB_PASSWORD=changeme

# Mot de passe d'accès unique à l'outil (usage interne, pas de comptes multiples).
# Laisser vide pour désactiver la protection (déconseillé en production).
APP_ACCESS_PASSWORD=changeme

# Jeton dédié à l'interface MCP (`POST /mcp`), transmis via Authorization: ******
# Laisser vide pour désactiver l'endpoint MCP.
APP_MCP_TOKEN=

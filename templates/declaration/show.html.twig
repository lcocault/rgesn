{% extends 'layout.html.twig' %}
{% block title %}Déclaration de conformité{% endblock %}
{% block content %}
<h1>Déclaration de conformité</h1>
<p class="muted">Générée le {{ declaration.generated_at|date("d/m/Y à H:i") }}.</p>
<div class="print-toolbar" style="display:flex;gap:0.6rem;">
    <a class="btn secondary" href="{{ path('/declarations/' ~ declaration.id ~ '/html') }}" target="_blank">Voir le document</a>
    <a class="btn" href="{{ path('/declarations/' ~ declaration.id ~ '/pdf') }}" target="_blank">Télécharger en PDF</a>
</div>
<div class="card">
    <iframe src="{{ path('/declarations/' ~ declaration.id ~ '/html') }}" style="width:100%;height:70vh;border:none;"></iframe>
</div>
{% endblock %}
